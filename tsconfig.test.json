{
  // Tests run under vitest (Node) but import both main (Node) and renderer (DOM)
  // code, so this config intentionally carries BOTH environments. Per-environment
  // isolation is enforced by tsconfig.node.json / tsconfig.web.json against the
  // shipped source; this config only typechecks the test files.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    // The records worker imports its sibling by its .ts name, so Node can run
    // the source as it is under the tests (src/main/io/records-worker.ts).
    "allowImportingTsExtensions": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node", "vite/client"],
    "paths": {
      "@shared/*": ["./src/shared/*"],
      "@main/*": ["./src/main/*"],
      "@renderer/*": ["./src/renderer/*"]
    }
  },
  "include": [
    "src/main/app-version.d.ts", "src/main/raw-import.d.ts","tests/**/*.ts", "tests/**/*.tsx"]
}
