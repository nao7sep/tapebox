{
  "name": "tapebox",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A local media library with web-import.",
  "author": "Yoshinao Inoguchi <nao7sep@gmail.com>",
  "license": "MIT",
  "main": "out/main/index.js",
  "build": {
    "appId": "io.github.nao7sep.tapebox",
    "productName": "TapeBox",
    "extraResources": [
      {
        "from": "build/Assets.car",
        "to": "Assets.car"
      }
    ],
    "mac": {
      "icon": "build/icon.icns",
      "extendInfo": {
        "CFBundleIconName": "vhs-cassette-front-azure-rose"
      }
    },
    "win": {
      "icon": "build/icon.ico"
    }
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web && npm run typecheck:test",
    "test": "vitest run",
    "test:watch": "vitest",
    "pack:mac": "electron-vite build && electron-builder --mac --dir",
    "pack:win": "electron-vite build && electron-builder --win --dir",
    "pack:linux": "electron-vite build && electron-builder --linux --dir",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "nanoid": "^5.1.11",
    "openai": "^6.44.0",
    "openpgp": "^6.3.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "unzipper": "^0.12.3",
    "write-file-atomic": "^8.0.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.1",
    "@types/node": "^25.9.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/unzipper": "^0.10.11",
    "@types/write-file-atomic": "^4.0.3",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^4.1.9",
    "electron": "^42.4.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.3.1",
    "typescript": "^6.0.3",
    "vite": "^7.3.3",
    "vitest": "^4.1.9"
  }
}
