{
  "name": "tapebox",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@12.0.2",
  "type": "module",
  "description": "A local media library with web-import.",
  "author": "Yoshinao Inoguchi <yoshinao@inoguchi.com>",
  "license": "MIT",
  "main": "out/main/index.js",
  "build": {
    "appId": "io.github.nao7sep.tapebox",
    "productName": "TapeBox",
    "extraResources": [
      {
        "from": "build/Assets.car",
        "to": "Assets.car"
      }
    ],
    "mac": {
      "icon": "build/icon.icns",
      "identity": "-",
      "artifactName": "${productName}-${version}-mac-arm64.${ext}",
      "extendInfo": {
        "CFBundleIconName": "vhs-cassette-front-azure-rose"
      },
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ]
    },
    "win": {
      "icon": "build/icon.ico",
      "artifactName": "${productName}-${version}-win-x64.${ext}",
      "target": [
        "nsis",
        "zip"
      ]
    },
    "nsis": {
      "artifactName": "${productName}-${version}-setup.${ext}"
    }
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck:node && npm run typecheck:web && electron-vite build",
    "dist": "npm run build && electron-builder --publish never",
    "preview": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web && npm run typecheck:test",
    "test": "vitest run",
    "check": "npm run typecheck && npm test",
    "check:release-tag": "node scripts/check-release-tag.mjs",
    "test:watch": "vitest",
    "pack:mac": "electron-vite build && electron-builder --mac --dir",
    "pack:win": "electron-vite build && electron-builder --win --dir",
    "pack:linux": "electron-vite build && electron-builder --linux --dir",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "nanoid": "^6.0.1",
    "openai": "^7.5.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "unzipper": "^0.12.5",
    "zod": "^4.4.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/unzipper": "^0.10.11",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^4.1.11",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^7.3.6",
    "vitest": "^4.1.11"
  },
  "allowScripts": {
    "electron-winstaller@5.4.0": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.1": true,
    "fsevents@2.3.3": false
  }
}
