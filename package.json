{
  "name": "tapebox",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@12.2.0",
  "type": "module",
  "description": "Download videos from the web into a private library, sort them into boxes, and watch them without autoplay pulling you along.",
  "author": "Yoshinao Inoguchi <yoshinao@inoguchi.com>",
  "license": "GPL-3.0-or-later",
  "main": "out/main/index.js",
  "build": {
    "appId": "io.github.nao7sep.tapebox",
    "productName": "TapeBox",
    "files": [
      "out/**/*",
      "package.json",
      "!**/*.map",
      "!**/*.d.ts",
      "!**/*.d.mts",
      "!**/*.d.cts"
    ],
    "extraResources": [
      {
        "from": "build/Assets.car",
        "to": "Assets.car"
      },
      {
        "from": "LICENSE",
        "to": "LICENSE.txt"
      }
    ],
    "electronLanguages": [
      "en",
      "en-US",
      "de",
      "es",
      "fr",
      "it",
      "pt_BR",
      "pt-BR",
      "ru",
      "ja",
      "ko",
      "zh_CN",
      "zh-CN"
    ],
    "mac": {
      "icon": "build/icon.icns",
      "identity": "-",
      "artifactName": "${productName}-${version}-mac-arm64.${ext}",
      "extendInfo": {
        "CFBundleIconName": "vhs-cassette-front-azure-rose",
        "CFBundleLocalizations": [
          "en",
          "de",
          "es",
          "fr",
          "it",
          "pt-BR",
          "ru",
          "ja",
          "ko",
          "zh-Hans"
        ]
      },
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ]
    },
    "win": {
      "icon": "build/icon.ico",
      "artifactName": "${productName}-${version}-win-x64.${ext}",
      "target": [
        "nsis",
        "zip"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "artifactName": "${productName}-${version}-setup.${ext}",
      "installerLanguages": [
        "en_US",
        "de_DE",
        "es_ES",
        "fr_FR",
        "it_IT",
        "pt_BR",
        "ru_RU",
        "ja_JP",
        "ko_KR",
        "zh_CN"
      ],
      "multiLanguageInstaller": true
    }
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck:node && npm run typecheck:web && electron-vite build",
    "dist": "npm run build && npm run prepare:electron && electron-builder --publish never && npm run check:package",
    "prepare:electron": "node node_modules/electron/install.js",
    "preview": "electron-vite preview",
    "typecheck:node": "tsc --noEmit --composite false -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit --composite false -p tsconfig.web.json",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web && npm run typecheck:test",
    "test": "npm run typecheck && vitest run",
    "test:full": "npm test && vitest run --config vitest.live.config.ts",
    "check:package": "node scripts/check-package-contents.mjs",
    "check:release-tag": "node scripts/check-release-tag.mjs",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@dnd-kit/dom": "^0.5.0",
    "@dnd-kit/react": "^0.5.0",
    "nanoid": "^6.0.2",
    "openai": "^7.32.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "stream-json": "^3.7.0",
    "unzipper": "^0.12.5",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@babel/parser": "^8.0.7",
    "@electron/asar": "^4.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/unzipper": "^0.10.11",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "electron": "^44.7.0",
    "electron-builder": "^26.17.0",
    "electron-vite": "^6.0.0",
    "jsdom": "^30.1.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "electron-winstaller@5.4.0": true,
    "fsevents@2.3.3": false
  }
}
